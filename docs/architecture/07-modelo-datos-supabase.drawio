        <mxCell id="legtitle_11" value="Leyenda de estado (evidencia real)" style="text;fontStyle=1;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="1360" y="260" width="320" height="24" as="geometry" /></mxCell>
        <mxCell id="leg_12" value="🟢 IMPLEMENTADO Y PROBADO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1360" y="290" width="300" height="34" as="geometry" /></mxCell>
        <mxCell id="leg_13" value="🔵 IMPLEMENTADO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1360" y="332" width="300" height="34" as="geometry" /></mxCell>
        <mxCell id="leg_14" value="🟡 IMPLEMENTADO PERO NO PROBADO EN PRODUCCIÓN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1360" y="374" width="300" height="34" as="geometry" /></mxCell>
        <mxCell id="leg_15" value="🟠 PLANIFICADO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1360" y="416" width="300" height="34" as="geometry" /></mxCell>
        <mxCell id="leg_16" value="🔴 BLOQUEADO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1360" y="458" width="300" height="34" as="geometry" /></mxCell>
        <mxCell id="leg_17" value="⚫ RETIRADO / LEGACY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1360" y="500" width="300" height="34" as="geometry" /></mxCell>
        <mxCell id="legshape1_18" value="Forma: rombo = gate/decisión de seguridad · óvalo = acción humana · contenedor punteado = agrupador (Local PC / Supabase / GitHub / APIs externas / Agente)" style="text;fontSize=10;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1360" y="546" width="320" height="60" as="geometry" /></mxCell>
        <mxCell id="note1" value="post_metrics y episode_log EXISTEN en producción real (confirmado por introspección PostgREST, Fase 1.1) pero ningún código los escribe/lee todavía (scheduleOptimization.mts está deliberadamente NOT_IMPLEMENTED). Se marcan PLANIFICADO, no probado." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1360" y="620" width="360" height="140" as="geometry" /></mxCell>
        <mxCell id="note2" value="claimed_at existe en producción real pero NO estaba en schema.sql original (hallazgo Fase 1.1, ya corregido en el schema versionado). publication_authorized_at/_by y publisher_operation_ref SÍ están aplicados y verificados contra Supabase real (Fase 5.5/5.15)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1360" y="780" width="360" height="150" as="geometry" /></mxCell>
        <mxCell id="note3" value="Tablas de Visteapy (profiles, wishlist_items, email_logs) NO pertenecen a este proyecto — existen en la misma base de datos pero fuera del alcance de este repositorio, no se incluyen aquí." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1360" y="950" width="360" height="110" as="geometry" /></mxCell>
