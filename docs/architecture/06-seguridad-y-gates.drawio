        <mxCell id="leg_21" value="🟡 IMPLEMENTADO PERO NO PROBADO EN PRODUCCIÓN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="940" y="154" width="300" height="34" as="geometry" /></mxCell>
        <mxCell id="leg_22" value="🟠 PLANIFICADO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="940" y="196" width="300" height="34" as="geometry" /></mxCell>
        <mxCell id="leg_23" value="🔴 BLOQUEADO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="940" y="238" width="300" height="34" as="geometry" /></mxCell>
        <mxCell id="leg_24" value="⚫ RETIRADO / LEGACY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="940" y="280" width="300" height="34" as="geometry" /></mxCell>
        <mxCell id="legshape1_25" value="Forma: rombo = gate/decisión de seguridad · óvalo = acción humana · contenedor punteado = agrupador (Local PC / Supabase / GitHub / APIs externas / Agente)" style="text;fontSize=10;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="940" y="326" width="320" height="60" as="geometry" /></mxCell>
        <mxCell id="note1" value="🟡 = barrera cubierta SOLO por tests con mocks, nunca ejercitada contra la plataforma real en producción (excepto YouTube, que sí tiene piloto real). channelIdentity para Instagram/Facebook es la brecha de seguridad más importante identificada: solo existe consistencia interna Supabase, nunca verificación contra la cuenta externa real." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="940" y="400" width="360" height="150" as="geometry" /></mxCell>
        <mxCell id="note2" value="Ninguna barrera de esta cadena puede saltarse desde el modo dirigido (POST_ID): scheduled_at futuro bloquea igual que en modo general, y las demás barreras viven en processPost(), sin ninguna rama alternativa." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="940" y="1150" width="360" height="110" as="geometry" /></mxCell>
