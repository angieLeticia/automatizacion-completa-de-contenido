        <mxCell id="folderNameGate" value="El nombre de carpeta es la ÚNICA forma
de reconocer una cuenta — si no está en
discoverAccounts.mts, NUNCA se procesa" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="300" width="420" height="80" as="geometry" /></mxCell>
        <mxCell id="contentAccount" value="content_account
(Supabase) — folder_name UNIQUE
channel_id UNIQUE FK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="socialChannel" value="social_channel
