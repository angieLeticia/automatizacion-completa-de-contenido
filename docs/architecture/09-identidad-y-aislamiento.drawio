        <mxCell id="socialAccount" value="social_account
channel_id FK, platform, credentials JSONB
UNIQUE(channel_id, platform)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="400" height="80" as="geometry" /></mxCell>
        <mxCell id="externalIdentity" value="EXTERNAL PLATFORM IDENTITY
YouTube: channels.list(mine=true) real
Instagram/Facebook: NO EXISTE verificación real" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="720" width="460" height="90" as="geometry" /></mxCell>
        <mxCell id="match" value="MATCH
credentials.channel_id === channel real
(verifyYoutubeChannelIdentity)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="870" width="320" height="80" as="geometry" /></mxCell>
        <mxCell id="mismatch" value="MISMATCH
BLOQUEO inmediato, fail-closed
(incidente real detectado y cerrado, Fase 5.18)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="870" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="credentialProvisioning" value="Aprovisionamiento por canal
YOUTUBE_CLIENT_ID_&lt;CANAL&gt; / _SECRET_&lt;CANAL&gt;
registro por nombre de variable, sin hardcode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="580" width="400" height="90" as="geometry" /></mxCell>
        <mxCell id="legtitle_19" value="Leyenda de estado (evidencia real)" style="text;fontStyle=1;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="1050" width="320" height="24" as="geometry" /></mxCell>
        <mxCell id="leg_20" value="🟢 IMPLEMENTADO Y PROBADO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="1080" width="300" height="34" as="geometry" /></mxCell>
        <mxCell id="leg_21" value="🔵 IMPLEMENTADO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="1122" width="300" height="34" as="geometry" /></mxCell>
        <mxCell id="leg_22" value="🟡 IMPLEMENTADO PERO NO PROBADO EN PRODUCCIÓN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="1164" width="300" height="34" as="geometry" /></mxCell>
        <mxCell id="leg_23" value="🟠 PLANIFICADO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="1206" width="300" height="34" as="geometry" /></mxCell>
        <mxCell id="leg_24" value="🔴 BLOQUEADO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="1248" width="300" height="34" as="geometry" /></mxCell>
        <mxCell id="leg_25" value="⚫ RETIRADO / LEGACY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="1290" width="300" height="34" as="geometry" /></mxCell>
        <mxCell id="legshape1_26" value="Forma: rombo = gate/decisión de seguridad · óvalo = acción humana · contenedor punteado = agrupador (Local PC / Supabase / GitHub / APIs externas / Agente)" style="text;fontSize=10;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="1336" width="320" height="60" as="geometry" /></mxCell>
        <mxCell id="note1" value="PRINCIPIO: PHYSICAL PATH → CHANNEL → CONTENT ACCOUNT → SOCIAL ACCOUNT → EXTERNAL PLATFORM IDENTITY. Un canal NUNCA debe publicar usando las credenciales de otro — esto ya ocurrió una vez en la práctica (Enciende El Caos vs Sin Explicación, Fase 5.18) y fue detectado por el propio gate MISMATCH, no por inspección humana." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="500" y="1050" width="420" height="170" as="geometry" /></mxCell>
        <mxCell id="note2" value="La verificación real MATCH/MISMATCH solo existe para YouTube. Instagram y Facebook dependen ÚNICAMENTE de la consistencia interna de Supabase (content_account.channel_id === social_account.channel_id) — nunca se confirma contra la cuenta externa real. Es la brecha de aislamiento más importante hoy." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="960" y="1050" width="420" height="170" as="geometry" /></mxCell>
