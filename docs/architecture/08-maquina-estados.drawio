        <mxCell id="legshape1_31" value="Forma: rombo = gate/decisión de seguridad · óvalo = acción humana · contenedor punteado = agrupador (Local PC / Supabase / GitHub / APIs externas / Agente)" style="text;fontSize=10;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="986" width="320" height="60" as="geometry" /></mxCell>
        <mxCell id="note1" value="Estas 4 máquinas de estado son SISTEMAS DISTINTOS, sobre tablas distintas — un episodio puede estar COMPLETED en producción mientras su archivo derivado sigue en 'analyzing' para siempre (ver hallazgo de content_files.status en el README)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="500" y="700" width="600" height="90" as="geometry" /></mxCell>
        <mxCell id="note2" value="Ningún estado de esta página fue inventado — todos provienen de un `type`/`CHECK` real en el código o en supabase/schema.sql, confirmado por grep exhaustivo antes de dibujar este diagrama." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="500" y="810" width="600" height="80" as="geometry" /></mxCell>
