        <mxCell id="legshape1_12" value="Forma: rombo = gate/decisión de seguridad · óvalo = acción humana · contenedor punteado = agrupador (Local PC / Supabase / GitHub / APIs externas / Agente)" style="text;fontSize=10;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1380" y="386" width="320" height="60" as="geometry" /></mxCell>
        <mxCell id="note1" value="Distinción clave: MULTIMEDIA real (video/audio) vive SIEMPRE en disco local o en Supabase Storage (solo IG/FB) — METADATA (títulos, estados, hashes, autorizaciones) vive en Supabase Postgres. YouTube nunca sube a Storage: se entrega directo desde disco al protocolo resumable de Google." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1380" y="480" width="380" height="160" as="geometry" /></mxCell>
