        <mxCell id="leg_17" value="⚫ RETIRADO / LEGACY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1780" y="280" width="300" height="34" as="geometry" /></mxCell>
        <mxCell id="legshape1_18" value="Forma: rombo = gate/decisión de seguridad · óvalo = acción humana · contenedor punteado = agrupador (Local PC / Supabase / GitHub / APIs externas / Agente)" style="text;fontSize=10;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1780" y="326" width="320" height="60" as="geometry" /></mxCell>
        <mxCell id="note1" value="Consumidores reales: todo Agent 2 (scripts/pipeline/*, processOne.mts) usa MachineBridge.filesystem/health/media/render — ya VALIDADO con evidencia real (incl. cold-cache, Fase 5.1). Agent 3 (publicación) NO consume MachineBridge todavía — usa fs/crypto directo (ver diagrama 05)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1780" y="400" width="400" height="140" as="geometry" /></mxCell>
        <mxCell id="note2" value="localAI es el único módulo sin implementar: existe como contrato de tipo (MachineBridge.localAI?, opcional a propósito) pensado para heredar la MISMA restricción de localhost que ya aplica checkOllamaReachable() — no una nueva." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1780" y="570" width="400" height="130" as="geometry" /></mxCell>
