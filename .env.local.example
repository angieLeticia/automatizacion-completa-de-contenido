# --- Supabase (fuente de verdad de estado/metadata de los 3 agentes) ---
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Service role key (NO la anon key): permite a los scripts de servidor leer/escribir
# saltando RLS. NUNCA exponer al navegador ni en NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Storage de trabajo (Agente 2 — material y estado local) ---
# Ruta raíz del material de video en este computador.
MATERIAL_ROOT=D:\MATERIAL VIDEOS

# --- Inbox (Fase 4.3 — carpeta observada de entrada, ver docs/content-ingestion.md) ---
# Opcional: si se omite, usa una carpeta "INBOX" hermana de MATERIAL_ROOT.
INBOX_ROOT=

# --- YouTube (Agente 3 — solo necesarias una vez, para obtener el refresh_token
# de un canal vía `npm run social:youtube-token`; las credenciales de publicación
# reales de cada cuenta viven en la tabla social_accounts, no aquí) ---
YOUTUBE_CLIENT_ID=xxxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-...

# --- ElevenLabs (Agente 2 — narración de audio) ---
ELEVENLABS_API_KEY=sk_...

# --- Anthropic / Whisper local (Agente 2 — análisis de contenido y transcripción) ---
ANTHROPIC_API_KEY=sk-ant-...
# Opcional — default razonable si se omite (ver agent/analyze/config.mts)
ANTHROPIC_MODEL=
WHISPER_MODEL=

# --- Proveedor LLM alternativo local (opcional — solo si LLM_PROVIDER=ollama) ---
LLM_PROVIDER=
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# --- Ajustes finos opcionales del pipeline/agente de publicación (todos tienen
# default seguro en código si se omiten — ver scripts/pipeline/config.mts,
# agent/config.mts y agent/publish/config.mts) ---
DRY_RUN=
RECONCILE_INTERVAL_MS=
FILE_STABILITY_SECONDS=
STALE_CLAIM_MINUTES=
CLAIMED_AT_MIGRATION_APPLIED=
EPISODE_FILTER=
